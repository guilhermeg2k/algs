# https://leetcode.com/problems/two-sum/

let two_sum = (nums: []number, target: number) -> []number
    let mut i = 0
    let mut j = len(nums) - 1

    for i < j
        let sum = nums[i] + nums [j]
        if sum == target
            return [i, j]

        if sum > target
            j -= 1
        else
            i += 1

let arr = [ 1, 10, 30, 32, 33, 54, 55, 90, 100, 110, 140, 1000 ]

echo(two_sum(arr, 109)) # 54+55 (5,6)
