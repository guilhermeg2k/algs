# https://leetcode.com/problems/3sum/description/

let three_sum = (nums: []number, target: number) -> [][]number
    let res: [][]number = []
    let size = len(nums)
    let mut i = 0

    for i < size - 1
        if i > 0 and nums[i] == nums[i - 1]
            i += 1
            continue

        let mut j = i + 1
        let mut w = size - 1

        for j < w
            let sum = nums[i] + nums[j] + nums[w]
            if sum == target
                append(res, [i, j, w])

            if sum > target
                w -= 1
            else
                j += 1


        i += 1

    return res

let arr = [ -10, -5, -5, -4, -3, -2, 10, 30, 32, 33, 54, 55, 90, 100, 110, 140, 1000 ]

echo(three_sum(arr, 0))
